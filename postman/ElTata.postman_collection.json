          "mode": "raw",
          "raw": "{\n  \"name\": \"Pizza Especial\",\n  \"description\": \"Muzzarella, jamón, morrones\",\n  \"price\": 2200,\n  \"category\": \"Pizzas\",\n  \"available\": true\n}"
        },
        "url": {"raw": "{{base_url}}/productos", "host": ["{{base_url}}"], "path": ["productos"]}
      }
    },
